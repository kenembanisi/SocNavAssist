<?xml version="1.0"?>
<sdf version="1.4">
  <world name="default">
    <model name='ground_plane'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
              <torsional>
                <ode/>
              </torsional>
            </friction>
            <contact>
              <ode/>
            </contact>
            <bounce/>
          </surface>
          <max_contacts>10</max_contacts>
        </collision>
        <visual name='visual'>
          <cast_shadows>0</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Tertiary</name>
            </script>
          </material>
        </visual>
        <self_collide>0</self_collide>
        <enable_wind>0</enable_wind>
        <kinematic>0</kinematic>
      </link>
    </model>
    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose frame=''>0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Other models -->
    <include>
      <uri>model://open_hall2</uri>
      <pose>-6.39 0.5 0 0 0 0</pose>
    </include>

    <!-- actor 1 -->
    <actor name="actor1">
      <skin>
        <filename>walk.dae</filename>
      </skin>
      <animation name="walking">
        <filename>walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <trajectory id="0" type="walking">
          <waypoint>
            <time>0</time>
            <pose>-8.45 8.41 0.0 0 0 -1.57</pose>
          </waypoint>
          <waypoint>
            <time>10</time>
            <pose>-8.45 -10.5 0 0 0 -1.57</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- actor 2 -->
    <actor name="actor2">
      <skin>
        <filename>model://actor/meshes/SKIN_man_blue_shirt.dae</filename>
      </skin>
      <animation name="animation">
        <filename>model://actor/meshes/ANIMATION_walking.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <trajectory id="0" type="animation">
          <waypoint>
            <time>0</time>
            <pose>-5.78 8.0 0.0 0 0 -1.57</pose>
          </waypoint>
          <waypoint>
            <time>14</time>
            <pose>-5.78 -10.5 0 0 0 -1.57</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- actor 3 -->
    <actor name="actor3">
      <skin>
        <filename>walk.dae</filename>
      </skin>
      <animation name="walking">
        <filename>walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <trajectory id="0" type="walking">
          <waypoint>
            <time>0</time>
            <pose>-13.14 1.65 0.0 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>17</time>
            <pose>0.45 1.62 0 0 0 0</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- actor 4 -->
    <actor name="actor4">
      <skin>
        <filename>model://actor/meshes/SKIN_man_blue_shirt.dae</filename>
      </skin>
      <animation name="animation">
        <filename>model://actor/meshes/ANIMATION_walking.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <trajectory id="0" type="animation">
          <waypoint>
            <time>0</time>
            <pose>-12.94 -8.18 0.0 0 0 1.07</pose>
          </waypoint>
          <waypoint>
            <time>10</time>
            <pose>0.30 5.03 0 0 0 1.07</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- actor 5 -->
    <actor name="actor5">
      <skin>
        <filename>model://actor/meshes/SKIN_man_blue_shirt.dae</filename>
      </skin>
      <animation name="animation">
        <filename>model://actor/meshes/ANIMATION_walking.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <trajectory id="0" type="animation">
          <waypoint>
            <time>0</time>
            <pose>0.32 -4.32 0.0 0 0 3.0</pose>
          </waypoint>
          <waypoint>
            <time>8</time>
            <pose>-13.13 -2.0 0 0 0 3.0</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>


    <include>
      <uri>model://goal_location</uri>
      <pose>-6.5 8.2 0.7 0 0 0</pose>
    </include>

    <!-- User Camera -->
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose frame=''>0.92 -7.97 22.96 0 0.675643 1.58</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
  </world>
</sdf>