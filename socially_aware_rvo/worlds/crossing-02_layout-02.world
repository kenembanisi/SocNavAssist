    <actor name="actor1">
      <pose>-1.09 5.81 0.0 0 0 0</pose>
      <skin>
        <filename>walk.dae</filename>
      </skin>
      <animation name="walking">
        <filename>walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>

      <plugin name="actor1_plugin" filename="libPedestrianSFMPlugin.so">
        <velocity>0.7</velocity>
        <radius>0.4</radius>
        <animation_factor>5.1</animation_factor>
        <people_distance>6.0</people_distance>
        <!-- weights -->
        <goal_weight>2.0</goal_weight>
        <obstacle_weight>20.0</obstacle_weight> <!--10.0-->
        <social_weight>2.1</social_weight> <!--2.1-->
        <group_gaze_weight>3.0</group_gaze_weight>
        <group_coh_weight>2.0</group_coh_weight>
        <group_rep_weight>1.0</group_rep_weight>
        <ignore_obstacles>
          <!-- <model>cafe</model> -->
          <model>ground_plane</model>
          <model>open_hall3</model>
          <model>trina2</model>
        </ignore_obstacles>
        <trajectory>
          <cyclic>true</cyclic>
          <waypoint>-1.09 5.89 0.0</waypoint>
          <waypoint>-12.7 5.44 0.0</waypoint>
        </trajectory>
      </plugin>

    </actor>

