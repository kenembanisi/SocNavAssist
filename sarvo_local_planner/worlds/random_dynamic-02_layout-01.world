    <!-- actor 1 -->
    <actor name="actor1">
      <pose>-6.09 8.89 0.0 0 0 0</pose>
      <skin>
        <filename>walk.dae</filename>
      </skin>
      <animation name="walking">
        <filename>walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>

      <plugin name="actor1_plugin" filename="libPedestrianSFMPlugin.so">
        <velocity>1.0</velocity>
        <radius>0.4</radius>
        <animation_factor>5.1</animation_factor>
        <people_distance>6.0</people_distance>
        <!-- weights -->
        <goal_weight>2.0</goal_weight>
        <obstacle_weight>20.0</obstacle_weight> <!--10.0-->
        <social_weight>10.1</social_weight> <!--2.1-->
        <group_gaze_weight>3.0</group_gaze_weight>
        <group_coh_weight>2.0</group_coh_weight>
        <group_rep_weight>1.0</group_rep_weight>
        <ignore_obstacles>
          <!-- <model>cafe</model> -->
          <model>ground_plane</model>
        </ignore_obstacles>
        <trajectory>
          <cyclic>true</cyclic>
          <waypoint>-6.09 8.89 0.0</waypoint>
          <waypoint>-10.49 -4.95 0.0</waypoint>
          <waypoint>-13.56 -5.09 0.0</waypoint>
          <waypoint>-12.91 -2.82 0.0</waypoint>
        </trajectory>
      </plugin>

    </actor>

    <!-- actor 2 (grouped with actor 3) -->
    <actor name="actor2">
      <pose>-12.93 5.47 0.0 0 0 0</pose>
      <skin>
        <filename>model://actor/meshes/SKIN_man_blue_shirt.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walking">
        <filename>model://actor/meshes/ANIMATION_walking.dae</filename>
        <!-- <scale>1.000000</scale> -->
        <interpolate_x>true</interpolate_x>
      </animation>

      <plugin name="actor2_plugin" filename="libPedestrianSFMPlugin.so">
        <velocity>1.0</velocity>
        <radius>0.4</radius>
        <animation_factor>5.1</animation_factor>
        <people_distance>6.0</people_distance>
        <!-- weights -->
        <goal_weight>2.0</goal_weight>
        <obstacle_weight>20.0</obstacle_weight> <!--10.0-->
        <social_weight>5</social_weight> <!--2.1-->
        <group_gaze_weight>3.0</group_gaze_weight>
        <group_coh_weight>2.0</group_coh_weight>
        <group_rep_weight>1.0</group_rep_weight>
        <!-- groups -->
        <group>
          <model>actor3</model>
        </group>
        <ignore_obstacles>
